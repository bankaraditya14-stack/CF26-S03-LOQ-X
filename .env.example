# ==============================================================================
# CASCADE CITY - Supabase Environment Configuration Template
# ==============================================================================
#
# HOW TO CONFIGURE SUPABASE:
# 1. Create a project at https://supabase.com
# 2. In your Supabase Project Dashboard, navigate to:
#    Project Settings -> API
# 3. Copy the following values:
#    - Project URL      -> VITE_SUPABASE_URL
#    - Project API Keys -> "anon" (public) -> VITE_SUPABASE_ANON_KEY
# 4. Copy this file to `.env.local`:
#    cp .env.example .env.local
# 5. Paste your real Project URL and anon public key below.
#
# NOTE: If these variables are not set or if Supabase is unreachable,
# Cascade City automatically runs in LOCAL MODE with full offline localStorage support.
# ==============================================================================

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
